<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Package visibility (Android 11+) for the payment-browser check in openPaymentSheet.
      The Custom Tabs service intent keeps every browser that can open an in-app payment sheet
      visible to the library's lookup; the http/https VIEW signature covers the default-browser
      enumeration; the explicit packages are the never-filtered second pass
      (see RNSwanBrowserModuleImpl.knownCustomTabsPackage) so a buyer who does have a proper
      browser is never wrongly told to install Chrome.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Browsers that can handle a web VIEW. The platform's parser allows at most
             ONE <data> scheme per <intent> inside <queries> ("intent tag may have at most
             one data scheme"), and aapt2 does NOT catch this — it only fails at install.
             Keep http and https as separate intents. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.google.android.apps.chrome" />
        <package android:name="com.brave.browser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.opera.browser" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="com.miui.browser" />
        <package android:name="com.android.browser" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Play policy: use the system photo picker (react-native-image-picker) instead of broad media access -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- CRITICAL: Explicitly remove MEDIA_PROJECTION permission added by Agora SDK -->
    <!-- We do NOT use screen recording/projection - only camera-based live streaming -->
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" 
        tools:node="remove" />
    
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      tools:replace="android:allowBackup">
      <uses-library android:name="org.webrtc" android:required="false" />
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_channel_id"
          android:value="live_sales"
          tools:replace="android:value" />
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_icon"
          android:resource="@drawable/ic_notification" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <intent-filter android:label="payment-success">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ileafu" android:host="payment-success" />
        </intent-filter>
        <intent-filter android:label="payment-cancel">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ileafu" android:host="payment-cancel" />
        </intent-filter>
        <intent-filter android:label="referral">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ileafu" android:host="refer" />
        </intent-filter>
        <intent-filter android:label="plant-deeplink">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <!-- ileafu://plant/?code= (slash) and ileafu://plant?code= (no slash) -->
            <data android:scheme="ileafu" android:host="plant" />
            <data android:scheme="ileafu" android:host="plant" android:pathPrefix="/" />
        </intent-filter>
        <intent-filter android:label="live-deeplink">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ileafu" android:host="live" />
        </intent-filter>
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="ileafu.com" android:pathPrefix="/refer" />
        </intent-filter>
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="ileafu.com" android:pathPrefix="/plant" />
        </intent-filter>
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="ileafu.com" android:pathPrefix="/live" />
        </intent-filter>
      </activity>
      
      <!-- CRITICAL: Agora SDK includes MediaProjection components even in voice-sdk -->
      <!-- We MUST explicitly remove them as we don't use screen sharing -->
      <!-- We only use camera-based live video streaming, NOT screen recording -->
      <service
        android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenSharingService"
        tools:node="remove" />
      <activity
        android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenCaptureAssistantActivity"
        tools:node="remove" />
    </application>
</manifest>